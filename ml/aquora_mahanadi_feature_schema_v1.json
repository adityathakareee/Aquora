    "phase7e_model_compatibility": "FULLY_COMPATIBLE",
    "authoritative_physics_engine": "engines/flood/solver.py",
    "description": "Standardized feature contract for DFO 3382 Mahanadi regional validation, mapping legacy Phase 7E model features to new high-resolution terrain and hydrographic predictors while explicitly declaring rainfall availability status."
  },
  "active_phase7e_model_features": {
    "description": "The exact seven features utilized in Phase 7E Kaggle package and baseline model inference.",
    "features": [
      {
        "name": "elevation_m",
        "type": "float32",
        "units": "meters above sea level (EGM2008 geoid)",
        "source_layer": "data/processed/phase7/terrain/mahanadi_dem_mosaic_30m.vrt",
        "resolution_m": 30.0,
        "status": "VERIFIED_AVAILABLE"
      },
      {
        "name": "slope_deg",
        "type": "float32",
        "units": "degrees (0.0 to 90.0)",
        "source_layer": "data/processed/phase7/terrain/mahanadi_slope_deg_30m.tif",
        "resolution_m": 30.0,
        "status": "VERIFIED_AVAILABLE"
      },
      {
        "name": "drainage_proxy_score",
        "type": "float32",
        "units": "dimensionless score [0.0, 1.0]",
        "source_formula": "1.0 / (1.0 + distance_to_river_m / 1000.0)",
        "source_layer": "data/processed/phase7/hydrography/mahanadi_distance_to_river_m_30m.tif",
        "resolution_m": 30.0,
        "status": "VERIFIED_AVAILABLE"
      },
      {

        "imputation_policy": "NO_FABRICATION_ALLOWED"
      },
      {
        "name": "rainfall_accum_24h_mm",
        "type": "float32",
        "units": "millimeters",
        "source_layer": null,
        "resolution_m": null,
        "status": "NOT_AVAILABLE_LOCALLY",
        "missing_indicator": true,
        "imputation_policy": "NO_FABRICATION_ALLOWED"
      },
      {
        "name": "rainfall_accum_72h_mm",
        "type": "float32",
        "units": "millimeters",
        "source_layer": null,
        "resolution_m": null,
        "status": "NOT_AVAILABLE_LOCALLY",
        "missing_indicator": true,
        "imputation_policy": "NO_FABRICATION_ALLOWED"
